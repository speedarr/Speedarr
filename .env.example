# Speedarr Environment Variables
# Copy this file to .env and modify as needed.
# All values below are optional — the app runs with sensible defaults.
# The container always listens on 9494; change the host side of the port mapping in docker-compose.yml to use another port.

# JWT secret key for authentication (auto-generated if not set)
# AUTH__SECRET_KEY=your-secret-key-here

# Encryption key for sensitive config values (auto-generated if not set)
# CONFIG_ENCRYPTION_KEY=your-fernet-key-here

# Enable verbose logging (default: false)
# DEBUG=true

# Reverse proxies whose X-Forwarded-For header is trusted for the login rate limit (default: 127.0.0.1)
# FORWARDED_ALLOW_IPS=172.18.0.2
